# Package

version       = "0.1.0"
author        = "Pietro Peterlongo"
description   = "Great tables for Nim: display tables built from parts, formatted and styled, rendered to HTML"
license       = "MIT"
srcDir        = "src"

# Dependencies

requires "nim >= 2.0.0"
# nimib is optional: `import tabelline/nimib` (nbTable) needs it; the core needs only the standard library.
