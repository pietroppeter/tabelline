  "cells": [
    "library(gt)\nlibrary(dplyr)\n\nlil_exibble <- exibble |> select(num, char, fctr, date, time) |> slice_head(n = 4)\ngt_ex <- gt(lil_exibble)\n\ngt_ex",
    "# R counts from 1: column 2 is char, last_col() the last one\ngt_ex |> cols_move_to_start(columns = c(date, 2, last_col()))",
    "gt_ex |> cols_move_to_start(columns = starts_with(\"c\") | starts_with(\"f\"))",
    "names(tidyselect::eval_select(quote(starts_with(\"c\") | starts_with(\"f\")), lil_exibble))",
    "gt_ex |> cols_move_to_start(columns = contains(\"c\"))"
  ],
