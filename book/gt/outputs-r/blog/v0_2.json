    "library(gt)\nlibrary(dplyr)\n\nexibble |>\n  select(currency, date, row) |>\n  head(4) |>\n  gt(rowname_col = \"row\") |>\n  data_color(\n    columns = currency,\n    palette = c(\"lightblue\", \"darkgreen\")\n  )",
