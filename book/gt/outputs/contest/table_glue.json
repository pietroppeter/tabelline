der-right-width: 1px; border-right-color: #D3D3D3; vertical-align: middle; text-align: left; }\n #qpcebjhiys .gt_empty_group_heading { padding: 0.5px; color: #333333; background-color: #FFFFFF; font-size: 100%; font-weight: initial; border-top-style: solid; border-top-width: 2px; border-top-color: #D3D3D3; border-bottom-style: solid; border-bottom-width: 2px; border-bottom-color: #D3D3D3; vertical-align: middle; }\n #qpcebjhiys .gt_from_md> :first-child { margin-top: 0; }\n #qpcebjhiys .gt_from_md> :last-child { margin-bottom: 0; }\n #qpcebjhiys .gt_row { padding-top: 8px; padding-bottom: 8px; padding-left: 5px; padding-right: 5px; margin: 10px; border-top-style: solid; border-top-width: 1px; border-top-color: #D3D3D3; border-left-style: none; border-left-width: 1px; border-left-color: #D3D3D3; border-right-style: none; border-right-width: 1px; border-right-color: #D3D3D3; vertical-align: middle; overflow-x: hidden; }\n #qpcebjhiys .gt_stub { color: #333333; background-color: #FFFFFF; font-size: 100%; font-weight: initial; text-transform: inherit; border-right-style: solid; border-right-width: 2px; border-right-color: #D3D3D3; padding-left: 5px; padding-right: 5px; }\n #qpcebjhiys .gt_indent_1 { text-indent: 5px; }\n #qpcebjhiys .gt_indent_2 { text-indent: calc(5px * 2); }\n #qpcebjhiys .gt_indent_3 { text-indent: calc(5px * 3); }\n #qpcebjhiys .gt_indent_4 { text-indent: calc(5px * 4); }\n #qpcebjhiys .gt_indent_5 { text-indent: calc(5px * 5); }\n #qpcebjhiys .gt_stub_row_group { color: #333333; background-color: #FFFFFF; font-size: 100%; font-weight: initial; text-transform: inherit; border-right-style: solid; border-right-width: 2px; border-right-color: #D3D3D3; padding-left: 5px; padding-right: 5px; vertical-align: top; }\n #qpcebjhiys .gt_row_group_first td { border-top-width: 2px; }\n #qpcebjhiys .gt_row_group_first th { border-top-width: 2px; }\n #qpcebjhiys .gt_striped { color: #333333; background-color: #F4F4F4; }\n #qpcebjhiys .gt_table_body { border-top-s